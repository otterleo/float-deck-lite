QFrame#KeyTile {
    background-color: #9120425e;
    /*border: 1px solid #4fa4a8a0;*/
    border: none;
    border-radius: 8px;
}


QFrame#KeyTile:hover {
    background-color: #9161717e;
    border: none;
    border-radius: 8px;
}

QFrame#KeyTile:pressed {
    background-color: #9161717e;
    border: none;
    border-radius: 8px;
}


QFrame#KeyTile QLabel {
    color: #80e9e9e9;
    font-weight: bold;
    background: transparent;
}

/**/

#KeyTile {
    background-color: #9120425e;
    /*border: 1px solid #4fa4a8a0;*/
    border: none;
    border-radius: 8px;
}

#KeyTile[feedback="true"] {
    background-color: #9161717e;
    border: 1px solid #fbfdfdfd;
    border-radius: 8px;
}

QPushButton#KeyTile QLabel {
    color: #80e9e9e9;
    font-weight: bold;
    background: transparent;
}


QPushButton#KeyTile:pressed {
    background-color: #9161717e;
    border: none;
    border-radius: 8px;
}


QPushButton[clicked="true"] {
    background-color: #181818;
    border: 1px solid #666666;
}

QDialog {
    background-color: #1e222b;
    color: #abb2bf;
}

QLabel {
    color: #abb2bf;
    font-family: 'Segoe UI';
}

QCheckBox {
    color: #abb2bf;
    font-family: 'Segoe UI';
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: #282c34;
    border: 1px solid #3e4451;
    border-radius: 3px;
}

QCheckBox::indicator:checked {
    background-color: #61afef;
    border: 1px solid #61afef;
}

QTableWidget {
    background-color: #282c34;
    color: #abb2bf;
    gridline-color: #3e4451;
    border: 1px solid #3e4451;
}

QTableWidget::item {
    padding: 5px;
}

QHeaderView::section {
    background-color: #21252b;
    color: #abb2bf;
    padding: 6px;
    border: 1px solid #3e4451;
}

QPushButton {
    background-color: #61afef;
    color: #1e2227;
    font-weight: bold;
    border-radius: 4px;
    padding: 7px 16px;
}

QPushButton:hover {
    background-color: #5298d2;
}            

QFrame#HUDContainer {
    background-color: #da16181c;
    border-radius: 12px;
}