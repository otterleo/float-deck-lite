QFrame#KeyTile {{
                background-color: {bg_color};
                border: 1.5px solid {active_border};
                border-radius: 8px;
            }}

            QFrame#KeyTile QLabel {{
                color: {text_color};
                background: transparent;
            }}

 QFrame#KeyTile {
                background-color: #61afef;
                border: 1.5px solid #98c379;
                border-radius: 8px;
            }

            QFrame#KeyTile QLabel {
                color: #1e2227;
                font-weight: bold;
                background: transparent;
            }            

QDialog {
    background-color: #1e222b;
    color: #abb2bf;
}

QLabel {
    color: #abb2bf;
    font-family: 'Segoe UI';
}

QCheckBox {
    color: #abb2bf;
    font-family: 'Segoe UI';
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: #282c34;
    border: 1px solid #3e4451;
    border-radius: 3px;
}

QCheckBox::indicator:checked {
    background-color: #61afef;
    border: 1px solid #61afef;
}

QTableWidget {
    background-color: #282c34;
    color: #abb2bf;
    gridline-color: #3e4451;
    border: 1px solid #3e4451;
}

QTableWidget::item {
    padding: 5px;
}

QHeaderView::section {
    background-color: #21252b;
    color: #abb2bf;
    padding: 6px;
    border: 1px solid #3e4451;
}

QPushButton {
    background-color: #61afef;
    color: #1e2227;
    font-weight: bold;
    border-radius: 4px;
    padding: 7px 16px;
}

QPushButton:hover {
    background-color: #5298d2;
}            

QFrame#HUDContainer {
    background-color: #16181c;
    border-radius: 12px;
}